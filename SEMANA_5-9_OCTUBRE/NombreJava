public class Nombre_por_consola {
//la variable scanner permite interpretar lo que el usuario ingresa
    public static void main(String[] args) {
       var scanner = new Scanner(System.in);
////       permite mostrar informacion en la consola
        System.out.println("dame tu nommbre: ");
//     la variable n guarda la informacion que el usuario ingreso y scanner.nextLine pasa esa informacion a string
        var n = scanner.nextLine();
        System.out.println("el nombre del jugador es: "+n );
    }
}
